{
  "name": "@mvd/table",
  "version": "0.2.0",
  "description": "A fully-featured, CSS-variable-themable React table component built on TanStack Table v9.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/Rtc2.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:lib",
    "build:lib": "tsdown",
    "build:storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "release": "pnpm run build:lib && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/react-table": "9.0.0-beta.58",
    "@tanstack/react-virtual": "^3.14.8"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@internationalized/date": "^3.12.3",
    "@lolmath/ui": "^9.2.0",
    "@mantine/core": "9.5.0",
    "@mantine/dates": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@mui/material": "^9.2.0",
    "@playwright/test": "^1.62.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dayjs": "^1.11.21",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "vite": "^8.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "keywords": [
    "react",
    "table",
    "datagrid",
    "tanstack-table",
    "data-table",
    "component-library"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
