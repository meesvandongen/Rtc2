{
  "name": "@mvd/table",
  "version": "0.6.0",
  "description": "A fully-featured, CSS-variable-themable React table component built on TanStack Table v9.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/Rtc2.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./mui": {
      "types": "./dist/adapters/mui.d.ts",
      "import": "./dist/adapters/mui.js"
    },
    "./mantine": {
      "types": "./dist/adapters/mantine.d.ts",
      "import": "./dist/adapters/mantine.js"
    },
    "./radix": {
      "types": "./dist/adapters/radix.d.ts",
      "import": "./dist/adapters/radix.js"
    },
    "./radix.css": "./dist/adapters/radix.css",
    "./lolmath": {
      "types": "./dist/adapters/lolmath.d.ts",
      "import": "./dist/adapters/lolmath.js"
    },
    "./lolmath.css": "./dist/adapters/lolmath.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:lib",
    "build:lib": "vp pack",
    "build:storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "release": "pnpm run build:lib && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
